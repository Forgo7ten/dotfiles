# =============================================================================
# MISE GLOBAL CONFIGURATION (~/.config/mise/config.toml)
# =============================================================================
{{ if eq .chezmoi.os "darwin" -}}
{{   template "dot_config.d/mise/macos.toml" . }}
{{ else if eq .chezmoi.os "linux" -}}
{{   if eq .system "client" -}}
{{     template "dot_config.d/mise/linux/client.toml" . }}
{{   else if eq .system "server" -}}
{{     template "dot_config.d/mise/linux/server.toml" . }}
{{   end -}}
{{ end -}}
