#!/usr/bin/env bash
# 当托管的 Claude 用户内容变化时，合并进 ~/.claude/CLAUDE.md
# 只改写 <!-- CHEZMOI-USER:START/END --> 段，保留 OMC 与本机其它内容
#
# 变化指纹（内容变更会触发本脚本重新执行）:
# {{ include "dot_claude/CLAUDE.user.md" | sha256sum }}

set -euo pipefail

SCRIPT="{{ joinPath .chezmoi.homeDir ".local/bin/common/sync-claude-prefs" }}"
TAG="[sync-claude-prefs]"

if [ ! -x "$SCRIPT" ]; then
  # apply 顺序下脚本文件应已就位；若尚未部署则跳过，避免阻塞
  echo "$TAG 未找到可执行文件: $SCRIPT ，跳过"
  exit 0
fi

echo "$TAG 检测到偏好内容变更，开始合并..."
"$SCRIPT"
