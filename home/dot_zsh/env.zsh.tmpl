# ~/.zsh/env.zsh
# Environment shared by every zsh invocation.

{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") }}
# Ubuntu 会在 /etc/zsh/zshrc 中全局初始化 compinit。
# 让Zinit来管理compinit
skip_global_compinit=1
{{- end }}


{{- if ne .system "server" }}
# Android SDK 根目录
{{- if eq .chezmoi.os "darwin" }}
export ANDROID_HOME="$HOME/Library/Android/sdk"
{{- else }}
export ANDROID_HOME="$HOME/Android/Sdk"
{{- end }}
{{- end }}

## uv 环境
export UV_CACHE_DIR="$HOME/.uv/cache"
export UV_PYTHON_INSTALL_DIR="$HOME/.uv/python"
export UV_TOOL_DIR="$HOME/.uv/tools"

{{- if eq .chezmoi.os "darwin" }}
# macOS eza 配置目录
export EZA_CONFIG_DIR="$HOME/.config/eza"
{{- end }}

# 应用通用 PATH 基础策略；.zprofile 会在登录初始化后再次应用。
[[ -r "$ZDOTDIR/path.zsh" ]] && source "$ZDOTDIR/path.zsh"
