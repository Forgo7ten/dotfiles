# ~/.zsh/env.zsh
# Environment shared by every zsh invocation.

{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.osRelease.id "ubuntu") }}
# Ubuntu initializes compinit globally in /etc/zsh/zshrc.
# 让Zinit来管理compinit
skip_global_compinit=1
{{- end }}

# Keep PATH unique and make mise shims available to non-interactive shells.
typeset -gU path
path=(
    ${HOME}/.local/bin(N-/)
    ${HOME}/.local/bin/common(N-/)
{{- if eq .chezmoi.os "darwin" }}
    ${HOME}/.local/bin/macos(N-/)
{{- end }}
    $path
    ${HOME}/.local/share/mise/shims
    /usr/local/{,s}bin(N-/)
)

{{- if ne .system "server" }}
# Android SDK
{{- if eq .chezmoi.os "darwin" }}
export ANDROID_HOME="$HOME/Library/Android/sdk"
{{- else }}
export ANDROID_HOME="$HOME/Android/Sdk"
{{- end }}

() {
    local -a android_paths=(
        "$ANDROID_HOME/tools"
        "$ANDROID_HOME/tools/bin"
        "$ANDROID_HOME/platform-tools"
    )
    local p

{{- if and (hasKey . "tools") (hasKey .tools "android_sdk_ndk_version") }}
    android_paths+=("$ANDROID_HOME/ndk/{{ .tools.android_sdk_ndk_version }}")
{{- end }}

{{- if and (hasKey . "tools") (hasKey .tools "android_sdk_buildtools_version") }}
    android_paths+=("$ANDROID_HOME/build-tools/{{ .tools.android_sdk_buildtools_version }}")
{{- end }}

    for p in "${android_paths[@]}"; do
        if [[ -d "$p" ]]; then
            path=("$p" $path)
        fi
    done
}
{{- end }}

## uv
export UV_CACHE_DIR="$HOME/.uv/cache"
export UV_PYTHON_INSTALL_DIR="$HOME/.uv/python"
export UV_TOOL_DIR="$HOME/.uv/tools"

{{- if eq .chezmoi.os "darwin" }}
# macOS eza config directory
export EZA_CONFIG_DIR="$HOME/.config/eza"
{{- end }}
